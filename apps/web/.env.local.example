# Supabase (REQUIRED)
# Use the dev project (drafto-dev) for local development.
# Production credentials should only be used in the Vercel production environment.
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co

# App base URL (REQUIRED). Used for the links in account-approval emails.
# Vercel sets the production value; locally it is the dev server.
# CI skips env validation, so a missing required var here only shows up locally.
APP_URL=http://localhost:3000

# Sentry (optional)
NEXT_PUBLIC_SENTRY_DSN=https://your-dsn@sentry.io/your-project
SENTRY_AUTH_TOKEN=your-sentry-auth-token
# Keep this set locally. "development" disables the Sentry SDK. Without it, a local
# production build (`pnpm build && pnpm start`) resolves to "production" and reports
# into the shared Free-plan quota. `pnpm dev` stays off either way.
NEXT_PUBLIC_SENTRY_ENVIRONMENT=development

# PostHog (optional)
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
NEXT_PUBLIC_POSTHOG_KEY=phc_your-posthog-key

# E2E test user (must be an approved user in your Supabase project)
# E2E_TEST_EMAIL=test@example.com
# E2E_TEST_PASSWORD=your-test-password

# E2E admin user (optional; runs e2e/admin.spec.ts). Use a separate approved account
# with profiles.is_admin = true — not the E2E test user above. The admin specs also
# need SUPABASE_SERVICE_ROLE_KEY (dev project), because /admin builds a service-role
# client on every render.
# E2E_ADMIN_EMAIL=admin@example.com
# E2E_ADMIN_PASSWORD=your-admin-password
# SUPABASE_SERVICE_ROLE_KEY=your-dev-service-role-key

# Sign in with Apple key (optional). DELETE /api/account uses it to revoke a user's
# Apple tokens when they delete their account (App Store guideline 5.1.1(v)).
# Revocation runs only when all three are set; without them deletion still works.
# The private key is the .p8 PEM (multi-line, or one line with literal \n escapes).
# Never commit the key. See docs/features/auth.md → "Sign in with Apple token revocation".
# APPLE_TEAM_ID=your-team-id
# APPLE_SIGN_IN_KEY_ID=your-key-id
# APPLE_SIGN_IN_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"

# Set to "true" to skip env validation (useful in CI without secrets)
# SKIP_ENV_VALIDATION=true
