# Supabase (REQUIRED)
# Use the dev project (drafto-dev) for local development.
# Production credentials should only be used in the Vercel production environment.
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co

# Sentry (optional)
NEXT_PUBLIC_SENTRY_DSN=https://your-dsn@sentry.io/your-project
SENTRY_AUTH_TOKEN=your-sentry-auth-token
# NEXT_PUBLIC_SENTRY_ENVIRONMENT=development

# PostHog (optional)
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
NEXT_PUBLIC_POSTHOG_KEY=phc_your-posthog-key

# E2E test user (must be an approved user in your Supabase project)
# E2E_TEST_EMAIL=test@example.com
# E2E_TEST_PASSWORD=your-test-password

# E2E admin user (optional; runs e2e/admin.spec.ts). Use a separate approved account
# with profiles.is_admin = true — not the E2E test user above. The admin specs also
# need SUPABASE_SERVICE_ROLE_KEY (dev project), because /admin builds a service-role
# client on every render.
# E2E_ADMIN_EMAIL=admin@example.com
# E2E_ADMIN_PASSWORD=your-admin-password
# SUPABASE_SERVICE_ROLE_KEY=your-dev-service-role-key

# Set to "true" to skip env validation (useful in CI without secrets)
# SKIP_ENV_VALIDATION=true
