# Ensure UTF-8 locale for CocoaPods (required when launched from launchd/cron)
ENV["LANG"] ||= "en_US.UTF-8"
ENV["LC_ALL"] ||= "en_US.UTF-8"

default_platform(:android)

PACKAGE_NAME = "eu.drafto.mobile"
PROJECT_ROOT = File.expand_path("..", __dir__)

# App Review answers App Store Connect otherwise blocks a submission on. Drafto
# integrates no ad framework (no IDFA), reaches the network only over HTTPS/TLS
# provided by the OS (exempt encryption — the same claim as
# ITSAppUsesNonExemptEncryption = false in app.config.ts), and ships no
# third-party content.
#
# Passed on every App Store upload, but deliver reads the hash only inside
# Deliver::SubmitForReview, which Runner#run reaches only when submit_for_review
# is true — and it reads only two of the three keys: update_export_compliance
# sends export_compliance_uses_encryption, update_submission_information sends
# content_rights_contains_third_party_content. `add_id_info_uses_idfa` appears
# nowhere in fastlane 2.232.2 (Apple retired the IDFA submission question), so it
# is kept as a declaration of intent, not because it travels anywhere. An
# upload-only `production` run sends none of them and leaves the questionnaire to
# whoever presses Submit in App Store Connect.
APPSTORE_SUBMISSION_INFORMATION = {
  add_id_info_uses_idfa: false,
  export_compliance_uses_encryption: false,
  content_rights_contains_third_party_content: false
}.freeze

# Machine-local secrets kept outside the repo. `android-env.sh` uses
# `export KEY=value`; `match-env.sh` is a bare `MATCH_PASSWORD=…` assignment with
# no `export`, which a plain `source` turns into a shell variable fastlane cannot
# see (the `set -a` workaround the release runbook used to document). Both forms
# are parsed here so `match` finds MATCH_PASSWORD without any shell preamble.
LOCAL_SECRET_FILES = ["android-env.sh", "match-env.sh"].freeze

# ---------- helpers ----------

def load_local_secrets
  LOCAL_SECRET_FILES.each do |name|
    secrets_file = File.join(Dir.home, "drafto-secrets", name)
    next unless File.exist?(secrets_file)

    File.readlines(secrets_file).each do |line|
      line = line.strip
      next if line.empty? || line.start_with?("#")

      # Parse "export KEY=value", "KEY=value" or "KEY=\"value\"".
      assignment = line.sub(/^export\s+/, "")
      key, value = assignment.split("=", 2)
      next unless key && value
      # Only a bare shell identifier is a variable assignment — this is what
      # keeps `if [ -f … ]; then` and friends out now that `export ` is optional.
      next unless key.match?(/\A[A-Za-z_][A-Za-z0-9_]*\z/)

      # Skip lines with shell expansions (e.g., $(command))
      next if value.include?("$(")

      value = value.gsub(/\A["']|["']\z/, "") # strip surrounding quotes
      value = value.gsub("$HOME", Dir.home)
      ENV[key] ||= value
    end
  end
end

load_local_secrets

def load_production_env
  env_file = File.join(PROJECT_ROOT, ".env.production")
  if File.exist?(env_file)
    File.readlines(env_file).each do |line|
      line = line.strip
      next if line.empty? || line.start_with?("#")
      key, value = line.split("=", 2)
      ENV[key] = value if key && value
    end
  end
end

def write_local_properties
  sdk_dir = ENV["ANDROID_SDK_ROOT"] || ENV["ANDROID_HOME"] || File.join(Dir.home, "Library", "Android", "sdk")
  File.write(File.join(PROJECT_ROOT, "android", "local.properties"), "sdk.dir=#{sdk_dir}\n")
end

# JDK range the Android Gradle build can run on. Gradle runs on JAVA_HOME (else
# /usr/bin/java = the newest installed JDK), and the wrapper `expo prebuild`
# generates (android/gradle/wrapper/gradle-wrapper.properties) is Gradle 9.0.0,
# which supports running only on JDK 17-24
# (docs.gradle.org/9.0.0/userguide/compatibility.html); AGP 8.12 / React Native
# 0.83 need >= 17. Revisit GRADLE_MAX_JDK whenever an Expo / RN upgrade changes
# that wrapper version. JDK 25 is unsupported but happened to build; JDK 26
# (Homebrew's `temurin` cask, 2026-09-12) fails while evaluating
# android/build.gradle with "Unsupported class file major version 70", which
# broke every mobile beta.
GRADLE_MIN_JDK = 17
GRADLE_MAX_JDK = 24
# Tie-break among in-range JDKs: 21 is what this build is verified on, 17 is
# React Native's documented baseline; any other in-range JDK (newest first) is
# used only when neither is installed.
GRADLE_PREFERRED_JDKS = [21, 17].freeze
ANDROID_STUDIO_JBR_HOMES = [
  "/Applications/Android Studio.app/Contents/jbr/Contents/Home",
  File.join(Dir.home, "Applications", "Android Studio.app", "Contents", "jbr", "Contents", "Home")
].freeze

# Major version of the JDK at `java_home`, read from its `release` file
# (JAVA_VERSION="26.0.2.1" → 26, "1.8.0_392" → 8), or nil if unreadable. Read as
# binary so a stray non-ASCII byte can't raise an encoding error mid-lane.
def jdk_major_version(java_home)
  release_file = File.join(java_home.to_s, "release")
  return nil unless File.file?(release_file)

  version = File.binread(release_file)[/^JAVA_VERSION="([^"]+)"/n, 1]
  return nil if version.nil?

  major = version[/\A1\.(\d+)/n, 1] || version[/\A(\d+)/n, 1]
  major&.to_i
rescue SystemCallError
  nil
end

def gradle_compatible_jdk_major?(major)
  !major.nil? && major.between?(GRADLE_MIN_JDK, GRADLE_MAX_JDK)
end

# Every installed JDK home worth trying, by location: the macOS JVM directories
# (what /usr/libexec/java_home scans, and where `brew install --cask temurin@N`
# lands), Homebrew openjdk formulae, Android Studio's bundled JBR, then JDKs
# Gradle auto-provisioned for toolchains. Globbed rather than asked of
# /usr/libexec/java_home: its `-v` takes only an exact version or a lower bound
# (`-v 17+` returns JDK 26 here), an unmatched `-v N` without --failfast
# silently returns the default JDK, and it scans only the JavaVirtualMachines
# directories (never Android Studio's JBR or Gradle's jdks), so it can't
# express "any installed 17-24".
def installed_jdk_homes
  gradle_user_home = ENV["GRADLE_USER_HOME"].to_s
  gradle_user_home = File.join(Dir.home, ".gradle") if gradle_user_home.empty?
  patterns = [
    "/Library/Java/JavaVirtualMachines/*/Contents/Home",
    File.join(Dir.home, "Library", "Java", "JavaVirtualMachines", "*", "Contents", "Home"),
    "/opt/homebrew/opt/openjdk*/libexec/openjdk.jdk/Contents/Home",
    "/usr/local/opt/openjdk*/libexec/openjdk.jdk/Contents/Home",
    *ANDROID_STUDIO_JBR_HOMES,
    File.join(gradle_user_home, "jdks", "*", "Contents", "Home"),
    File.join(gradle_user_home, "jdks", "*", "*", "Contents", "Home")
  ]
  patterns.flat_map { |pattern| Dir.glob(pattern) }.uniq
end

# The installed in-range JDK to run Gradle on — a GRADLE_PREFERRED_JDKS major
# first, else the newest; ties keep installed_jdk_homes order — or nil.
def best_gradle_compatible_jdk
  ranked = installed_jdk_homes.each_with_index.filter_map do |home, index|
    major = jdk_major_version(home)
    next unless gradle_compatible_jdk_major?(major)

    [GRADLE_PREFERRED_JDKS.index(major) || GRADLE_PREFERRED_JDKS.size, -major, index, home]
  end
  ranked.min&.last
end

# Point JAVA_HOME at a JDK Gradle can run on: an in-range JAVA_HOME is kept;
# otherwise the best installed in-range JDK wins. If none exists, warn and leave
# the environment untouched rather than fail — the build may still work, and
# the warning names the fix.
def use_gradle_compatible_jdk
  range = "#{GRADLE_MIN_JDK}-#{GRADLE_MAX_JDK}"
  explicit = ENV["JAVA_HOME"].to_s
  explicit_major = explicit.empty? ? nil : jdk_major_version(explicit)
  if gradle_compatible_jdk_major?(explicit_major)
    UI.message("Gradle JDK: keeping JAVA_HOME #{explicit} (JDK #{explicit_major})")
    return
  end

  chosen = best_gradle_compatible_jdk
  if chosen.nil?
    UI.important(
      "No JDK #{range} found (checked JAVA_HOME, /Library/Java/JavaVirtualMachines, " \
      "~/Library/Java/JavaVirtualMachines, Homebrew openjdk, Android Studio's JBR, Gradle's jdks). " \
      "Gradle will run on #{explicit.empty? ? 'the default java' : explicit} and may fail " \
      "(JDK 26: 'Unsupported class file major version 70'). " \
      "Fix: `brew install --cask temurin@21`."
    )
    return
  end

  chosen_label = "#{chosen} (JDK #{jdk_major_version(chosen)})"
  if explicit.empty?
    UI.message("Gradle JDK: #{chosen_label}")
  else
    UI.important(
      "JAVA_HOME #{explicit} (JDK #{explicit_major || 'unknown'}) is outside the " \
      "JDK #{range} range Gradle supports — overriding with #{chosen_label}"
    )
  end
  ENV["JAVA_HOME"] = chosen
end

def json_key_path
  ENV["GOOGLE_PLAY_SERVICE_ACCOUNT_KEY_PATH"] || File.join(PROJECT_ROOT, "google-play-service-account.json")
end

def run_in_project(*args)
  Dir.chdir(PROJECT_ROOT) do
    sh(*args)
  end
end

# `build` is the iOS build number (nil for android). It is forwarded to
# post-release-notes.mjs as --build so TestFlight notes target that exact iOS
# build — macOS + iOS share one App Store Connect app, so "the newest build"
# alone can resolve to a macOS (desktop) build.
def post_release_notes(platform:, max_chars:, build: nil)
  Dir.chdir(PROJECT_ROOT) do
    notes = sh("bash", "scripts/generate-release-notes.sh", "--max-chars", max_chars.to_s).strip
    next if notes.empty?

    cmd = ["node", "scripts/post-release-notes.mjs", "--platform", platform, "--notes", notes]
    cmd += ["--build", build.to_s] unless build.nil? || build.to_s.empty?
    sh(*cmd)
  end
rescue StandardError => e
  UI.important("Release notes posting failed (non-fatal): #{e.message}")
end

# Phase G: walk PRs merged since the last `mobile@*` tag, find `Closes #N`
# refs, and comment "Now live in <track>." on each linked support issue.
# `track` is the customer-facing label (e.g. "TestFlight build 145"),
# composed by the caller because Fastlane has direct access to the lane
# and build identifier. Best-effort — a comment failure shouldn't fail
# the release pipeline.
def comment_released_issues(platform:, build:, track:)
  return if build.nil? || build.to_s.empty? || track.nil? || track.empty?
  Dir.chdir(PROJECT_ROOT) do
    repo_root = `git rev-parse --show-toplevel`.strip
    script = File.join(repo_root, "scripts", "comment-released-issues.mjs")
    next unless File.exist?(script)
    sh("node", script,
       "--platform", platform,
       "--build", build.to_s,
       "--track", track,
       "--tag-prefix", "mobile@",
       "--paths", "apps/mobile/,packages/shared/")
  end
rescue StandardError => e
  UI.important("Released-issue comments failed (non-fatal): #{e.message}")
end

def package_json_version
  require "json"
  JSON.parse(File.read(File.join(PROJECT_ROOT, "package.json")))["version"]
end

# A boolean lane option. Fastlane's CLI already turns `promote submit:false` into
# a real `false`, but a lane invoked from Ruby (or a future fastlane) can still
# hand over the string — accept both rather than silently treating "false" as
# truthy, which would submit an app to App Review the operator asked not to.
def option_bool(options, key, default)
  raw = options[key]
  return default if raw.nil? || raw.to_s.strip.empty?
  return raw if raw == true || raw == false

  case raw.to_s.strip.downcase
  when "true", "1", "yes" then true
  when "false", "0", "no" then false
  else UI.user_error!("#{key}: expected true or false, got #{raw.inspect}")
  end
end

# The already-uploaded build `promote` will submit for review, or a hard stop.
#
# `upload_to_app_store(skip_binary_upload: true)` does not verify that the build
# it names exists or has finished processing; it would happily "succeed" and
# leave the App Store version without a reviewable binary. Resolve and validate
# first. `asc_platform` is App Store Connect's platform token ("ios" / "osx") —
# iOS and macOS share ASC app 6760675784, so it (and app_identifier) must always
# be explicit or the lookup can cross platforms.
def resolve_promote_build_number(api_key:, asc_platform:, app_identifier:, app_version:, requested: nil)
  build_number = requested.to_s.strip
  if build_number.empty?
    build_number = latest_testflight_build_number(
      api_key: api_key,
      app_identifier: app_identifier,
      version: app_version,
      platform: asc_platform,
      initial_build_number: 0
    ).to_s
  end

  if build_number.empty? || build_number == "0"
    UI.user_error!(
      "No uploaded build found for version #{app_version} (#{asc_platform}) of #{app_identifier}. " \
      "Ship a TestFlight build first (iOS: `pnpm release:beta:ios`, macOS: `pnpm release:beta`), " \
      "or pass an explicit build_number:."
    )
  end

  assert_build_processed(
    app_identifier: app_identifier,
    asc_platform: asc_platform,
    build_number: build_number
  )
  build_number
end

# Refuse to submit a build Apple has not finished processing.
#
# Deliberately asymmetric: a build App Store Connect reports as anything but
# VALID is a hard `UI.user_error!`, but a LOOKUP that fails for any other reason
# (API shape change, transient 5xx) only warns — a promote lane must not become
# unusable because a diagnostic call broke.
def assert_build_processed(app_identifier:, asc_platform:, build_number:)
  asc_enum = asc_platform.to_s.casecmp("osx").zero? ? "MAC_OS" : "IOS"
  state =
    begin
      app = Spaceship::ConnectAPI::App.find(app_identifier)
      if app.nil?
        UI.important("#{app_identifier} not found in App Store Connect — skipping the processing-state check")
        return
      end
      builds = app.get_builds(
        filter: { version: build_number, "preReleaseVersion.platform" => asc_enum },
        includes: "preReleaseVersion"
      )
      if builds.nil? || builds.empty?
        UI.user_error!(
          "Build #{build_number} (#{asc_enum}) does not exist in App Store Connect for " \
          "#{app_identifier} — there is nothing to submit."
        )
      end
      builds.first.processing_state
    rescue FastlaneCore::Interface::FastlaneError
      raise # our own UI.user_error! above — never downgrade it to a warning
    rescue StandardError => e
      UI.important("Could not read the processing state of build #{build_number} (#{e.message}) — continuing")
      nil
    end
  return if state.nil?

  unless state.to_s == "VALID"
    UI.user_error!(
      "Build #{build_number} (#{asc_enum}) is #{state}, not VALID — Apple is still processing it. " \
      "Wait for App Store Connect to finish (the 'ready to test' email) and re-run."
    )
  end
end

# Apply the App Store release settings `deliver` silently drops, and return the
# editable version it configured.
#
# In fastlane 2.232.2 `phased_release` and `automatic_release` are read in exactly
# ONE place: Deliver::UploadMetadata#upload derives `releaseType` from
# automatic_release (deliver/lib/deliver/upload_metadata.rb:181-196) and creates
# or deletes the phased release (:313-331). That method returns on its first line
# when skip_metadata is set (:88-89), and nothing else under deliver/lib touches
# either option. A promote lane MUST skip metadata — the repo keeps no `deliver`
# metadata directory, so uploading it would blank the App Store Connect version
# page — and therefore cannot get these applied by passing them to
# upload_to_app_store. It has to patch App Store Connect itself.
#
# This is not cosmetic. With releaseType left alone it keeps whatever the version
# already holds, and App Store Connect preselects "Automatically release this
# version" — so a submission the lane reported as manual would go public the
# moment Apple approved it, and `phased_release:false` would not turn phasing off.
#
# Runs BEFORE the submission, which is also deliver's own order (Runner#run:
# verify_version → upload_metadata → … → submit_for_review), so the version is
# still PREPARE_FOR_SUBMISSION when patched rather than in review. Every failure
# is a hard stop: nothing has been submitted yet, so a re-run costs nothing,
# whereas continuing would submit under settings the lane is about to claim it
# applied.
def apply_appstore_release_settings(asc_platform:, app_identifier:, app_version:, phased_release:, automatic_release:)
  platform = Spaceship::ConnectAPI::Platform.map(asc_platform)
  app = Spaceship::ConnectAPI::App.find(app_identifier)
  if app.nil?
    UI.user_error!(
      "#{app_identifier} not found in App Store Connect — cannot set the release settings for " \
      "#{app_version} (#{asc_platform})."
    )
  end

  # Idempotent, and the very call deliver's own verify_version makes moments later
  # with the same arguments: renames the editable version to app_version, or
  # creates it when the platform has none.
  app.ensure_version!(app_version, platform: platform)

  version = app.get_edit_app_store_version(platform: platform)
  if version.nil?
    UI.user_error!(
      "No editable #{asc_platform} App Store version for #{app_version}. Create it in App Store " \
      "Connect (App Store → #{asc_platform.to_s.casecmp('osx').zero? ? 'macOS' : 'iOS'} App) and re-run."
    )
  end

  # Read the phased-release state BEFORE anything is patched, and through a call
  # whose failure cannot be mistaken for "there is none".
  #
  # version.fetch_app_store_version_phased_release cannot be made fail-closed: a
  # version with no phased release answers with a body spaceship refuses to parse
  # (`raise "No data"`, spaceship/connect_api/model.rb:82), so ABSENCE ITSELF
  # arrives as an exception — and so do a 401, a 429 and a 5xx, by which point the
  # HTTP status and Apple's error code are gone (ConnectAPI::APIClient#format_errors
  # keeps only "title - detail", api_client.rb:340-355), leaving nothing to
  # discriminate on. deliver rescues the call regardless
  # (deliver/upload_metadata.rb:315-319); copying that rescue here would let a
  # transient failure look like absence, so `phased_release: false` would skip the
  # deletion while the lane went on to report phasing off — exactly the unverified
  # claim about App Store Connect this helper exists to prevent.
  #
  # Re-reading the version with the relationship INCLUDED is unambiguous instead:
  # Apple answers 200 with either a linked appStoreVersionPhasedRelease or an empty
  # relationship, and spaceship inflates the former into a model while leaving the
  # latter nil (connect_api/model.rb:133-166). `nil` therefore means App Store
  # Connect said there is none, and every failure — including an `include` Apple
  # rejects — stays an exception that stops the lane before anything is submitted
  # and before releaseType is touched.
  detailed = Spaceship::ConnectAPI::AppStoreVersion.get(
    app_store_version_id: version.id,
    includes: "appStoreVersionPhasedRelease"
  )
  if detailed.nil?
    UI.user_error!(
      "App Store version #{version.id} (#{app_version}, #{asc_platform}) could not be re-read from " \
      "App Store Connect — refusing to submit under release settings that cannot be verified."
    )
  end
  existing = detailed.app_store_version_phased_release

  release_type =
    if automatic_release
      Spaceship::ConnectAPI::AppStoreVersion::ReleaseType::AFTER_APPROVAL
    else
      Spaceship::ConnectAPI::AppStoreVersion::ReleaseType::MANUAL
    end
  version.update(attributes: { releaseType: release_type })
  UI.message("Release type set to #{release_type} on #{asc_platform} version #{version.version_string}")

  if phased_release
    if existing
      UI.message("Phased release already configured (#{existing.phased_release_state})")
    else
      version.create_app_store_version_phased_release(
        attributes: {
          phasedReleaseState: Spaceship::ConnectAPI::AppStoreVersionPhasedRelease::PhasedReleaseState::INACTIVE
        }
      )
      UI.message("Phased release created — INACTIVE until the version is released")
    end
  elsif existing
    existing.delete!
    UI.message("Phased release removed — every user gets the update at once")
  else
    # Stated rather than skipped silently: this branch is the one place the lane
    # reports phasing off without having changed anything, so the log has to show
    # that App Store Connect was actually read and had none.
    UI.message("No phased release on the #{asc_platform} version — every user gets the update at once")
  end

  version
end

# Uploads ./fastlane/screenshots/<locale>/*.png to the App Store version that is
# currently editable ("Prepare for Submission") on `platform`, replacing that
# locale's existing screenshots. deliver picks each PNG's display type from its
# pixel size. No app_version is passed, so deliver neither creates nor renames a
# version; nothing is built, no metadata is touched, nothing is submitted.
def upload_store_screenshots(platform:, app_identifier:)
  screenshots_path = File.join(PROJECT_ROOT, "fastlane", "screenshots")
  pngs = Dir.glob(File.join(screenshots_path, "*", "*.png"))
  UI.user_error!("No screenshots in #{screenshots_path} — run the store/screenshots generator first") if pngs.empty?

  api_key = app_store_connect_api_key(
    key_id: ENV["ASC_API_KEY_ID"],
    issuer_id: ENV["ASC_API_ISSUER_ID"],
    key_filepath: ENV["ASC_API_KEY_P8_PATH"],
    key_content: ENV["ASC_API_KEY_P8"],
    in_house: false
  )

  upload_to_app_store(
    api_key: api_key,
    app_identifier: app_identifier,
    platform: platform,
    screenshots_path: screenshots_path,
    overwrite_screenshots: true,
    skip_binary_upload: true,
    skip_metadata: true,
    skip_app_version_update: true,
    submit_for_review: false,
    run_precheck_before_submit: false,
    force: true
  )
  UI.success("Uploaded #{pngs.length} screenshots (#{platform})")
end

# Tag a shipped mobile release, so generate-release-notes.sh scopes the NEXT
# build's "What to Test" to the delta since this one. Without it the newest
# `mobile@` tag was `mobile@1.1.7` while the app shipped 1.3.x, so every build's
# notes dumped ~15 features going back to #265 — desktop had this and mobile
# never did.
#
# The tag carries the PLATFORM because iOS and Android ship the same version
# under two independent build counters (1.3.0 was iOS build 32 and Android build
# 41). A bare `mobile@<version>+<build>` would be ambiguous between them, and
# ordering two such tags by refname is meaningless — which is why the generator
# picks the newest `mobile@` tag by CREATION DATE rather than by version sort.
#
# NEVER tag a pre-merge test build. Those lanes build the PR head, which is
# unmerged and may be rebased away, leaving a published tag as the only thing
# keeping a dead commit alive — and starting the next real release's range on an
# abandoned branch. Both happened to desktop before this guard existed.
def tag_release(platform:, build:)
  if !ENV["DRAFTO_INTEST_ISSUE"].to_s.empty?
    UI.message("Pre-merge test build (issue ##{ENV['DRAFTO_INTEST_ISSUE']}) — not tagging an unmerged commit")
    return
  end
  return if build.nil? || build.to_s.empty?

  release_tag = "mobile@#{package_json_version}+#{platform}.#{build}"
  if `git tag -l "#{release_tag}"`.strip.empty?
    sh("git", "tag", release_tag)
    sh("git", "push", "origin", release_tag)
    UI.success("Tagged release #{release_tag}")
  else
    UI.message("Release tag #{release_tag} already exists — skipping")
  end
rescue StandardError => e
  UI.important("Release tagging failed (non-fatal): #{e.message}")
end

# Pre-merge (factory In Test) dispatch only: report the actual build number on
# the card, since the In Test comment could only promise a build was coming.
# DRAFTO_INTEST_ISSUE is set by scripts/lib/dispatch-release.mjs
# dispatch-premerge; unset for every normal/post-merge release, where this is a
# no-op. Best-effort — a comment must never fail a build that already shipped.
def comment_intest_build(platform:, build:, track:)
  issue = ENV["DRAFTO_INTEST_ISSUE"]
  return if issue.nil? || issue.empty?
  return if build.nil? || build.to_s.empty?
  Dir.chdir(PROJECT_ROOT) do
    repo_root = `git rev-parse --show-toplevel`.strip
    script = File.join(repo_root, "scripts", "comment-intest-build.mjs")
    next unless File.exist?(script)
    cmd = ["node", script,
           "--issue", issue,
           "--platform", platform,
           "--build", build.to_s,
           "--track", track]
    cmd += ["--pr", ENV["DRAFTO_INTEST_PR"]] unless ENV["DRAFTO_INTEST_PR"].to_s.empty?
    cmd += ["--sha", ENV["DRAFTO_INTEST_SHA"]] unless ENV["DRAFTO_INTEST_SHA"].to_s.empty?
    sh(*cmd)
  end
rescue StandardError => e
  UI.important("In Test build comment failed (non-fatal): #{e.message}")
end

# ---------- Android ----------

platform :android do
  desc "Build and submit to Google Play internal track"
  lane :beta do
    build_and_submit(track: "internal")
  end

  desc "Build and submit to Google Play production track"
  lane :production do
    build_and_submit(track: "production")
  end

  private_lane :build_and_submit do |options|
    track = options[:track]

    # Load production Supabase credentials
    load_production_env

    # Generate native project
    run_in_project("npx", "expo", "prebuild", "--platform", "android", "--clean")

    # Write local.properties for Gradle to find Android SDK
    write_local_properties

    # Run Gradle on a JDK in the range its wrapper supports (see GRADLE_MAX_JDK)
    use_gradle_compatible_jdk

    # Allow native access up front: JDK 24+ warns on restricted native calls
    # without it (JEP 472). Every JDK in the supported range accepts the flag.
    ENV["_JAVA_OPTIONS"] = "--enable-native-access=ALL-UNNAMED"

    # Auto-increment version code from store
    latest_codes = google_play_track_version_codes(
      package_name: PACKAGE_NAME,
      track: track,
      json_key: json_key_path
    )
    next_code = (latest_codes.max || 0) + 1
    android_set_version_code(
      gradle_file: File.join(PROJECT_ROOT, "android", "app", "build.gradle"),
      version_code: next_code
    )

    # Build signed AAB
    gradle(
      task: "bundle",
      build_type: "Release",
      project_dir: File.join(PROJECT_ROOT, "android")
    )

    # Upload to Google Play
    upload_to_play_store(
      track: track,
      aab: File.join(PROJECT_ROOT, "android", "app", "build", "outputs", "bundle", "release", "app-release.aab"),
      json_key: json_key_path,
      package_name: PACKAGE_NAME,
      skip_upload_metadata: true,
      skip_upload_images: true,
      skip_upload_screenshots: true
    )

    # Post release notes
    post_release_notes(platform: "android", max_chars: 500)

    # Phase G: comment "Now live" on closed support issues for this build.
    # Track label distinguishes internal-track beta from production for the
    # customer-facing email (TestFlight is iOS-only — Android beta is the
    # Play "internal" track).
    track_label =
      track == "production" ? "Google Play (build #{next_code})" : "Google Play internal track (build #{next_code})"
    comment_released_issues(platform: "android", build: next_code, track: track_label)
    comment_intest_build(platform: "android", build: next_code, track: track_label)
    tag_release(platform: "android", build: next_code)
  end
end

# ---------- iOS ----------

platform :ios do
  desc "Build and submit to TestFlight"
  lane :beta do
    build_and_submit(destination: "testflight")
  end

  desc "Rebuild from source and upload to the App Store (hotfix path). Pass submit:true to also submit for review; prefer `promote`, which submits the build testers already validated."
  lane :production do |options|
    build_and_submit(destination: "appstore", submit: options[:submit])
  end

  desc "Submit an ALREADY-UPLOADED TestFlight build for App Store review. Does not build — no expo prebuild, no CocoaPods, no gym — so it never touches native tooling. Options: build_number: (default: newest iOS build of the package.json version), submit: (true), phased_release: (true), automatic_release: (false)."
  lane :promote do |options|
    app_version = package_json_version
    submit = option_bool(options, :submit, true)
    phased_release = option_bool(options, :phased_release, true)
    automatic_release = option_bool(options, :automatic_release, false)

    api_key = app_store_connect_api_key(
      key_id: ENV["ASC_API_KEY_ID"],
      issuer_id: ENV["ASC_API_ISSUER_ID"],
      key_filepath: ENV["ASC_API_KEY_P8_PATH"],
      key_content: ENV["ASC_API_KEY_P8"],
      in_house: false
    )

    build_number = resolve_promote_build_number(
      api_key: api_key,
      asc_platform: "ios",
      app_identifier: PACKAGE_NAME,
      app_version: app_version,
      requested: options[:build_number]
    )

    # deliver cannot apply phased_release:/automatic_release: under
    # skip_metadata: true (see apply_appstore_release_settings), so set them here,
    # before anything is submitted. Gated on submit: submit:false is a dry run and
    # must leave the version's release settings untouched.
    if submit
      apply_appstore_release_settings(
        asc_platform: "ios",
        app_identifier: PACKAGE_NAME,
        app_version: app_version,
        phased_release: phased_release,
        automatic_release: automatic_release
      )
    end

    # automatic_release:/phased_release: are INERT on this call — deliver reads
    # them only in UploadMetadata#upload, which returns immediately under
    # skip_metadata: true. apply_appstore_release_settings above is what actually
    # applies them; they stay here because the spec asks for them and because a
    # future fastlane that honours them would set the same two values.
    upload_to_app_store(
      api_key: api_key,
      app_identifier: PACKAGE_NAME,
      app_version: app_version,
      build_number: build_number,
      platform: "ios",
      skip_binary_upload: true,
      skip_metadata: true,
      skip_screenshots: true,
      submit_for_review: submit,
      automatic_release: automatic_release,
      phased_release: phased_release,
      force: true,
      precheck_include_in_app_purchases: false,
      submission_information: APPSTORE_SUBMISSION_INFORMATION
    )

    # No comment_released_issues / tag_release here: submitting for review is not
    # a release. The build was already announced when it went to TestFlight, and
    # comment-released-issues.mjs posts "Now live in <track>", which would be a
    # lie until Apple approves and the operator presses Release This Version.
    #
    # submit:false is a dry run, NOT a "stage the build" mode. deliver consumes
    # build_number only in SubmitForReview#select_build — the single caller of
    # AppStoreVersion#select_build — and Runner#run skips that step entirely when
    # submit_for_review is false. With the binary, metadata and screenshots all
    # skipped, what remains is verify_version (which creates or renames the
    # editable App Store version) plus precheck: the build is resolved and
    # validated, but nothing is attached to the version.
    UI.success(
      "iOS #{app_version} (build #{build_number}) → App Store: " \
      "#{submit ? 'submitted for review' : 'build resolved and validated only — NOT attached to the version, NOT submitted'}"
    )
    if submit
      UI.message("Phased release for automatic updates: #{phased_release ? 'on' : 'off'}")
      UI.message(
        automatic_release ? "Release: automatic once approved" : "Release: manual — press Release This Version after approval"
      )
    else
      UI.message(
        "phased_release:/automatic_release: were NOT applied — a dry run leaves the App Store " \
        "version's release settings exactly as they are."
      )
    end
  end

  desc "Upload fastlane/screenshots (from store/screenshots/generate-ios.sh) to the App Store version"
  desc "being prepared, replacing its en-US screenshots. Builds and submits nothing; changes the store listing."
  lane :upload_screenshots do
    upload_store_screenshots(platform: "ios", app_identifier: PACKAGE_NAME)
  end

  private_lane :build_and_submit do |options|
    destination = options[:destination]
    submit_for_review = option_bool(options, :submit, false)

    # Load production Supabase credentials
    load_production_env

    # Generate native project
    run_in_project("npx", "expo", "prebuild", "--platform", "ios", "--clean")

    # Install CocoaPods dependencies (creates .xcworkspace)
    cocoapods(
      podfile: File.join(PROJECT_ROOT, "ios", "Podfile"),
      try_repo_update_on_error: true
    )

    # Configure App Store Connect API key
    api_key = app_store_connect_api_key(
      key_id: ENV["ASC_API_KEY_ID"],
      issuer_id: ENV["ASC_API_ISSUER_ID"],
      key_filepath: ENV["ASC_API_KEY_P8_PATH"],
      key_content: ENV["ASC_API_KEY_P8"],
      in_house: false
    )

    # Fetch signing credentials from match
    match(
      type: "appstore",
      app_identifier: PACKAGE_NAME,
      api_key: api_key,
      readonly: true
    )

    # Auto-increment build number from TestFlight
    new_build_number = latest_testflight_build_number(api_key: api_key) + 1
    increment_build_number(
      build_number: new_build_number,
      xcodeproj: File.join(PROJECT_ROOT, "ios", "Drafto.xcodeproj")
    )

    # Build IPA
    update_code_signing_settings(
      path: File.join(PROJECT_ROOT, "ios", "Drafto.xcodeproj"),
      use_automatic_signing: false,
      team_id: "4J2USPSG2U",
      profile_name: "match AppStore eu.drafto.mobile",
      code_sign_identity: "Apple Distribution"
    )

    build_app(
      workspace: File.join(PROJECT_ROOT, "ios", "Drafto.xcworkspace"),
      scheme: "Drafto",
      export_method: "app-store",
      output_directory: File.join(PROJECT_ROOT, "ios", "build")
    )

    # Upload
    if destination == "testflight"
      upload_to_testflight(
        api_key: api_key,
        ipa: File.join(PROJECT_ROOT, "ios", "build", "Drafto.ipa"),
        skip_waiting_for_build_processing: true
      )
    else
      # app_version / platform are explicit because ASC app 6760675784 serves BOTH
      # iOS and macOS — left to deliver's own guess, a submission can land on the
      # wrong platform's version. submission_information only reaches App Store
      # Connect on the submit:true path — deliver sends it from SubmitForReview —
      # so an upload-only run leaves the IDFA / export-compliance questions to be
      # answered when someone submits from App Store Connect.
      upload_to_app_store(
        api_key: api_key,
        app_identifier: PACKAGE_NAME,
        app_version: package_json_version,
        platform: "ios",
        ipa: File.join(PROJECT_ROOT, "ios", "build", "Drafto.ipa"),
        skip_metadata: true,
        skip_screenshots: true,
        submit_for_review: submit_for_review,
        force: submit_for_review,
        precheck_include_in_app_purchases: false,
        submission_information: APPSTORE_SUBMISSION_INFORMATION
      )
    end

    # Post release notes for THIS iOS build (not just the newest build in the
    # shared macOS+iOS ASC app). post-release-notes.mjs polls until the build is
    # indexed, so the upload above needn't block on full processing.
    post_release_notes(platform: "ios", max_chars: 4000, build: new_build_number)

    # Phase G: comment "Now live" on closed support issues for this build — for
    # TestFlight ONLY. comment-released-issues.mjs posts "Now live in <track>",
    # and an App Store upload is not a release: the build still has to pass App
    # Review and then be released by hand. Telling a customer their fix is live
    # on the App Store the moment a binary is uploaded is simply false.
    if destination == "appstore"
      UI.message(
        "App Store upload — no customer 'now live' notice: the build is not public until Apple " \
        "approves it and Release This Version is pressed."
      )
    else
      track_label = "TestFlight (build #{new_build_number})"
      comment_released_issues(platform: "ios", build: new_build_number, track: track_label)
      comment_intest_build(platform: "ios", build: new_build_number, track: track_label)
    end
    tag_release(platform: "ios", build: new_build_number)
  end
end
