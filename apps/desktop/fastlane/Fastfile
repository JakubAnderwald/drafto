# Ensure UTF-8 locale for CocoaPods (required when launched from launchd/cron)
ENV["LANG"] ||= "en_US.UTF-8"
ENV["LC_ALL"] ||= "en_US.UTF-8"

default_platform(:mac)

BUNDLE_ID = "eu.drafto.mobile"
PROJECT_ROOT = File.expand_path("..", __dir__)

# App Review answers App Store Connect otherwise blocks a submission on. Drafto
# integrates no ad framework (no IDFA), reaches the network only over HTTPS/TLS
# provided by the OS (exempt encryption — the same claim as
# ITSAppUsesNonExemptEncryption = false in macos/Drafto-macOS/Info.plist), and
# ships no third-party content.
#
# Passed on every App Store upload, but deliver reads the hash only inside
# Deliver::SubmitForReview, which Runner#run reaches only when submit_for_review
# is true — and it reads only two of the three keys: update_export_compliance
# sends export_compliance_uses_encryption, update_submission_information sends
# content_rights_contains_third_party_content. `add_id_info_uses_idfa` appears
# nowhere in fastlane 2.232.2 (Apple retired the IDFA submission question), so it
# is kept as a declaration of intent, not because it travels anywhere. An
# upload-only `production` run sends none of them and leaves the questionnaire to
# whoever presses Submit in App Store Connect.
APPSTORE_SUBMISSION_INFORMATION = {
  add_id_info_uses_idfa: false,
  export_compliance_uses_encryption: false,
  content_rights_contains_third_party_content: false
}.freeze

# Machine-local secrets kept outside the repo. `android-env.sh` uses
# `export KEY=value`; `match-env.sh` is a bare `MATCH_PASSWORD=…` assignment with
# no `export`, which a plain `source` turns into a shell variable fastlane cannot
# see — that is why `bundle exec fastlane mac beta` used to bail at `match` with
# "Neither the MATCH_PASSWORD environment variable nor the local keychain
# contained a password" unless the caller wrapped it in `set -a`. Both forms are
# parsed here, so no shell preamble is needed any more.
LOCAL_SECRET_FILES = ["android-env.sh", "match-env.sh"].freeze

# ---------- helpers ----------

def load_local_secrets
  LOCAL_SECRET_FILES.each do |name|
    secrets_file = File.join(Dir.home, "drafto-secrets", name)
    next unless File.exist?(secrets_file)

    File.readlines(secrets_file).each do |line|
      line = line.strip
      next if line.empty? || line.start_with?("#")

      # Parse "export KEY=value", "KEY=value" or "KEY=\"value\"".
      assignment = line.sub(/^export\s+/, "")
      key, value = assignment.split("=", 2)
      next unless key && value
      # Only a bare shell identifier is a variable assignment — this is what
      # keeps `if [ -f … ]; then` and friends out now that `export ` is optional.
      next unless key.match?(/\A[A-Za-z_][A-Za-z0-9_]*\z/)
      next if value.include?("$(")

      value = value.gsub(/\A["']|["']\z/, "")
      value = value.gsub("$HOME", Dir.home)
      ENV[key] ||= value
    end
  end
end

load_local_secrets

# `build` is the macOS build number just uploaded. post-release-notes.mjs needs
# it to target THAT build: macOS and iOS share one App Store Connect app, and iOS
# builds also carry the macOS-only fields the script used to match on.
def post_release_notes(max_chars:, build:)
  Dir.chdir(PROJECT_ROOT) do
    notes = sh("bash", "scripts/generate-release-notes.sh", "--max-chars", max_chars.to_s).strip
    next if notes.empty?

    sh("node", "scripts/post-release-notes.mjs", "--platform", "macos", "--notes", notes, "--build", build.to_s)
  end
rescue StandardError => e
  UI.important("Release notes posting failed (non-fatal): #{e.message}")
end

# Phase G: walk PRs merged since the last `desktop@*` tag, find `Closes #N`
# refs, and comment "Now live in <track>." on each linked support issue.
# `track` is the customer-facing label (e.g. "TestFlight macOS build 145").
# Best-effort — a comment failure shouldn't fail the release pipeline.
def comment_released_issues(build:, track:)
  return if build.nil? || build.to_s.empty? || track.nil? || track.empty?
  Dir.chdir(PROJECT_ROOT) do
    repo_root = `git rev-parse --show-toplevel`.strip
    script = File.join(repo_root, "scripts", "comment-released-issues.mjs")
    next unless File.exist?(script)
    sh("node", script,
       "--platform", "macos",
       "--build", build.to_s,
       "--track", track,
       "--tag-prefix", "desktop@",
       "--paths", "apps/desktop/,packages/shared/")
  end
rescue StandardError => e
  UI.important("Released-issue comments failed (non-fatal): #{e.message}")
end

# Pre-merge (factory In Test) dispatch only: report the actual build number on
# the card, since the In Test comment could only promise a build was coming.
# DRAFTO_INTEST_ISSUE is set by scripts/lib/dispatch-release.mjs
# dispatch-premerge; unset for every normal/post-merge release, where this is a
# no-op. Best-effort — a comment must never fail a build that already shipped.
def comment_intest_build(build:, track:)
  issue = ENV["DRAFTO_INTEST_ISSUE"]
  return if issue.nil? || issue.empty?
  return if build.nil? || build.to_s.empty?
  Dir.chdir(PROJECT_ROOT) do
    repo_root = `git rev-parse --show-toplevel`.strip
    script = File.join(repo_root, "scripts", "comment-intest-build.mjs")
    next unless File.exist?(script)
    cmd = ["node", script,
           "--issue", issue,
           "--platform", "macos",
           "--build", build.to_s,
           "--track", track]
    cmd += ["--pr", ENV["DRAFTO_INTEST_PR"]] unless ENV["DRAFTO_INTEST_PR"].to_s.empty?
    cmd += ["--sha", ENV["DRAFTO_INTEST_SHA"]] unless ENV["DRAFTO_INTEST_SHA"].to_s.empty?
    sh(*cmd)
  end
rescue StandardError => e
  UI.important("In Test build comment failed (non-fatal): #{e.message}")
end

def package_json_version
  require "json"
  JSON.parse(File.read(File.join(PROJECT_ROOT, "package.json")))["version"]
end

# The monorepo root: apps/desktop/../.. The repo is `node-linker=hoisted`, so
# react-native-macos and React live in its node_modules, which is where the
# Podfile builds React from ('../../../node_modules/react-native-macos').
def desktop_repo_root
  root = File.expand_path("../..", PROJECT_ROOT)
  return root if File.exist?(File.join(root, "pnpm-workspace.yaml"))

  UI.user_error!("Cannot find the monorepo root: no pnpm-workspace.yaml at #{root}")
end

# The installed version of a hoisted package, or nil when it is missing or unreadable.
def installed_package_version(root, name)
  require "json"
  manifest = File.join(root, "node_modules", name, "package.json")
  return nil unless File.exist?(manifest)

  JSON.parse(File.read(manifest))["version"]
rescue JSON::ParserError
  nil
end

# react-native-macos 0.83 peers React ^19.2.0, the single copy the root
# pnpm.overrides pins for every app (ADR-0067).
DESKTOP_REACT_LINE = /\A19\.2\.\d+/

# Dependency preflight. A stale checkout (the retired React 19.1 fossil, or a
# `git pull` with no `pnpm install` after it) compiles green and then crashes in
# Hermes/JSI at launch (#558). Refuse to build unless the installed
# react-native-macos is exactly the version apps/desktop/package.json declares
# and React is 19.2.x. scripts/lib/dispatch-release.mjs checks the same thing
# before the factory spawns a desktop lane.
def assert_desktop_dependencies!
  require "json"
  root = desktop_repo_root
  declared = JSON.parse(File.read(File.join(PROJECT_ROOT, "package.json"))).then { |pkg| pkg.dig("dependencies", "react-native-macos") || pkg.dig("devDependencies", "react-native-macos") }
  rnm = installed_package_version(root, "react-native-macos")
  react = installed_package_version(root, "react")

  problems = []
  if declared.nil?
    problems << "apps/desktop/package.json declares no react-native-macos"
  elsif rnm != declared
    problems << "node_modules/react-native-macos is #{rnm || 'missing'}, but apps/desktop/package.json declares #{declared}"
  end
  problems << "node_modules/react is #{react || 'missing'}, but react-native-macos needs 19.2.x" unless react.to_s.match?(DESKTOP_REACT_LINE)

  unless problems.empty?
    UI.user_error!(
      "Desktop dependencies don't match the checkout — run `pnpm install` at the repo root (#{root}), then retry.\n  - " \
      "#{problems.join("\n  - ")}"
    )
  end
  UI.success("Dependency preflight: react-native-macos #{rnm}, react #{react}")
end

# Xcode's script phases source macos/.xcode.env, which sources the gitignored
# .xcode.env.local for NODE_BINARY. `pod install` writes that file only when it
# is missing, so a path left behind by a removed or upgraded node survives and
# breaks the Pods' Hermes and codegen script phases (the app's own bundle phase
# exports NODE_BINARY=node and relies on PATH). Rewrite it from the node on PATH
# when it is missing or its NODE_BINARY is not an executable file. The value is
# read the way the phases read it, by sourcing the file in bash, and written
# shell-quoted so a path with a space survives.
def ensure_xcode_env_local_node_binary
  require "open3"
  require "shellwords"
  env_local = File.join(PROJECT_ROOT, "macos", ".xcode.env.local")
  current = ""
  if File.exist?(env_local)
    out, status = Open3.capture2("bash", "-c", '. "$1" >/dev/null 2>&1; printf %s "$NODE_BINARY"', "_", env_local)
    current = status.success? ? out.strip : ""
  end
  if !current.empty? && File.file?(current) && File.executable?(current)
    UI.message("macos/.xcode.env.local NODE_BINARY=#{current}")
    return
  end

  node = `node -p process.execPath 2>/dev/null`.strip
  unless $?.success? && !node.empty? && File.executable?(node)
    UI.user_error!("Cannot derive NODE_BINARY: `node -p process.execPath` failed. Put node on PATH, then retry.")
  end
  File.write(env_local, "export NODE_BINARY=#{Shellwords.escape(node)}\n")
  UI.success("Wrote macos/.xcode.env.local: NODE_BINARY=#{node} (was #{current.empty? ? 'unset' : current})")
end

# RCTThirdPartyComponentsProvider maps component names to NSClassFromString()
# results. Some of those classes (e.g. RNSFullWindowOverlay) are iOS-only and nil on
# macOS, and upstream's codegen template builds the map as an NSDictionary literal,
# which crashes the app at launch on a nil value. The Podfile's post_install rewrites
# the template (and the generator's entry lines) to an NSMutableDictionary that skips
# nil classes. The compiled provider comes from react-native-macos's template: the
# ReactCodegen pod's "Generate Specs" phase regenerates it right before compiling,
# after post_install has run. The copy `pod install` writes earlier, before
# post_install, is overwritten then, so rewriting that copy protects nothing. A text
# patch that stops matching does nothing, without any error, so check after
# CocoaPods that the template is nil-safe.
def assert_nil_safe_component_provider!
  template = File.join(desktop_repo_root, "node_modules", "react-native-macos", "scripts", "codegen", "templates", "RCTThirdPartyComponentsProviderMM.template")
  unless File.exist?(template)
    UI.user_error!("#{template} is missing: react-native-macos's codegen moved it. Point the Podfile's nil-safe patch and this check at its new place.")
  end
  if File.read(template).include?("thirdPartyComponents = @{")
    UI.user_error!(
      "#{template} still builds the component map from an NSDictionary literal, so a component " \
      "class missing on macOS crashes the app at launch. The Podfile's post_install patch no " \
      "longer matches it: update the patch for this react-native-macos version."
    )
  end
  UI.success("RCTThirdPartyComponentsProvider template is nil-safe")
end

# Tracked files build_and_submit rewrites in place on every run (paths relative to
# PROJECT_ROOT). increment_build_number writes the TestFlight build number into
# both, increment_version_number and update_code_signing_settings write
# project.pbxproj, and update_info_plist writes Info.plist. None of it belongs in
# a commit: the next run derives every value again (the build number from
# latest_testflight_build_number). Left in place, though, it dirties the primary
# checkout after every release, and the next `git pull` there refuses to update
# those files.
LANE_REWRITTEN_FILES = [
  "macos/Drafto-macOS/Info.plist",
  "macos/Drafto.xcodeproj/project.pbxproj"
].freeze

# Runs the block, then restores every LANE_REWRITTEN_FILES entry that matched HEAD
# when it started, whether the build succeeded or failed. A file that was already
# modified is left alone, because those are someone's uncommitted edits. If git
# cannot answer, the file counts as modified, so the worst case is the old
# behaviour (a dirty checkout), never lost work.
#
# Podfile.lock is deliberately not covered: when `cocoapods` rewrites it, the pods
# really changed, and that belongs in a commit (see #618).
def restoring_lane_rewritten_files
  clean = Dir.chdir(PROJECT_ROOT) do
    LANE_REWRITTEN_FILES.select do |path|
      system("git", "diff", "--quiet", "HEAD", "--", path, err: File::NULL)
    end
  end
  yield
ensure
  restore_lane_rewritten_files(clean) if clean
end

def restore_lane_rewritten_files(paths)
  return if paths.empty?

  Dir.chdir(PROJECT_ROOT) { sh("git", "checkout", "HEAD", "--", *paths) }
  UI.message("Restored #{paths.join(', ')} — the lane's build-number writes are not meant to be committed")
rescue StandardError => e
  UI.important("Could not restore #{paths.join(', ')} (non-fatal): #{e.message}")
end

# A boolean lane option. Fastlane's CLI already turns `promote submit:false` into
# a real `false`, but a lane invoked from Ruby (or a future fastlane) can still
# hand over the string — accept both rather than silently treating "false" as
# truthy, which would submit an app to App Review the operator asked not to.
def option_bool(options, key, default)
  raw = options[key]
  return default if raw.nil? || raw.to_s.strip.empty?
  return raw if raw == true || raw == false

  case raw.to_s.strip.downcase
  when "true", "1", "yes" then true
  when "false", "0", "no" then false
  else UI.user_error!("#{key}: expected true or false, got #{raw.inspect}")
  end
end

# The already-uploaded build `promote` will submit for review, or a hard stop.
#
# `upload_to_app_store(skip_binary_upload: true)` does not verify that the build
# it names exists or has finished processing; it would happily "succeed" and
# leave the App Store version without a reviewable binary. Resolve and validate
# first. `asc_platform` is App Store Connect's platform token ("osx" here) —
# macOS and iOS share ASC app 6760675784, so it (and app_identifier) must always
# be explicit or the lookup can cross platforms.
def resolve_promote_build_number(api_key:, asc_platform:, app_identifier:, app_version:, requested: nil)
  build_number = requested.to_s.strip
  if build_number.empty?
    build_number = latest_testflight_build_number(
      api_key: api_key,
      app_identifier: app_identifier,
      version: app_version,
      platform: asc_platform,
      initial_build_number: 0
    ).to_s
  end

  if build_number.empty? || build_number == "0"
    UI.user_error!(
      "No uploaded build found for version #{app_version} (#{asc_platform}) of #{app_identifier}. " \
      "Ship a TestFlight build first (macOS: `pnpm release:beta`), or pass an explicit build_number:."
    )
  end

  assert_build_processed(
    app_identifier: app_identifier,
    asc_platform: asc_platform,
    build_number: build_number
  )
  build_number
end

def asc_platform_enum(asc_platform)
  asc_platform.to_s.casecmp("osx").zero? ? "MAC_OS" : "IOS"
end

# App Store Connect's builds with this build number on this platform, and under
# this marketing version when one is given; nil if the app itself is not found.
# macOS and iOS share one App Store Connect app, so the platform is never optional.
def find_asc_builds(app_identifier:, asc_platform:, build_number:, app_version: nil)
  app = Spaceship::ConnectAPI::App.find(app_identifier)
  return nil if app.nil?

  filter = { version: build_number.to_s, "preReleaseVersion.platform" => asc_platform_enum(asc_platform) }
  filter["preReleaseVersion.version"] = app_version if app_version
  app.get_builds(filter: filter, includes: "preReleaseVersion")
end

# Refuse to submit a build Apple has not finished processing.
#
# Deliberately asymmetric: a build App Store Connect reports as anything but
# VALID is a hard `UI.user_error!`, but a LOOKUP that fails for any other reason
# (API shape change, transient 5xx) only warns — a promote lane must not become
# unusable because a diagnostic call broke.
def assert_build_processed(app_identifier:, asc_platform:, build_number:)
  asc_enum = asc_platform_enum(asc_platform)
  state =
    begin
      builds = find_asc_builds(app_identifier: app_identifier, asc_platform: asc_platform, build_number: build_number)
      if builds.nil?
        UI.important("#{app_identifier} not found in App Store Connect — skipping the processing-state check")
        return
      end
      if builds.empty?
        UI.user_error!(
          "Build #{build_number} (#{asc_enum}) does not exist in App Store Connect for " \
          "#{app_identifier} — there is nothing to submit."
        )
      end
      builds.first.processing_state
    rescue FastlaneCore::Interface::FastlaneError
      raise # our own UI.user_error! above — never downgrade it to a warning
    rescue StandardError => e
      UI.important("Could not read the processing state of build #{build_number} (#{e.message}) — continuing")
      nil
    end
  return if state.nil?

  unless state.to_s == "VALID"
    UI.user_error!(
      "Build #{build_number} (#{asc_enum}) is #{state}, not VALID — Apple is still processing it. " \
      "Wait for App Store Connect to finish (the 'ready to test' email) and re-run."
    )
  end
end

# altool sometimes uploads the .pkg, prints "UPLOAD SUCCEEDED with no errors", and
# then logs "ERROR: … Failed to create URL for 'CDUploaderStateInfoResumeFilePath'"
# (a resume-state file it never needed). fastlane fails the upload on that ERROR
# line, so the lane stopped before the release notes, released-issue comments and
# release tag although the build was in App Store Connect (desktop 0.4.4 builds 74
# and 76). Tolerate exactly that error, and only once App Store Connect lists the
# build under this version: any other upload error, this one without the build, or
# a build Apple marked INVALID still fails the lane.
ALTOOL_SPURIOUS_RESUME_ERROR = "CDUploaderStateInfoResumeFilePath"
# fastlane joins every altool diagnostic into one exception, one
# "[Application Loader Error Output]: …" line each (FastlaneCore::AltoolTransporterExecutor
# #displayable_errors), and adds a line of its own when altool exits non-zero. The error is
# only spurious when it is the sole kind of diagnostic: one more error, or a non-zero exit,
# still fails the lane.
ALTOOL_DIAGNOSTIC_LINE = /^\s*\[(?:Application Loader|Transporter) Error Output\]: /

def only_spurious_resume_error?(message)
  diagnostics = message.to_s.lines.grep(ALTOOL_DIAGNOSTIC_LINE)
  !diagnostics.empty? && diagnostics.all? { |line| line.include?(ALTOOL_SPURIOUS_RESUME_ERROR) }
end
UPLOADED_BUILD_POLL_ATTEMPTS = 30
UPLOADED_BUILD_POLL_SECONDS = 20
# Processing states that mean the upload landed. Anything else (INVALID, FAILED) means it didn't.
UPLOADED_BUILD_OK_STATES = %w[PROCESSING VALID].freeze

def upload_to_testflight_checked(api_key:, pkg:, build_number:, app_version:)
  upload_to_testflight(
    api_key: api_key,
    pkg: pkg,
    # Don't block on Apple's processing (matches mobile). Waiting hung the
    # #623 pre-merge lane for 3 days: build 56 went VALID in App Store
    # Connect, but fastlane's poll never saw it, so the lane never exited
    # and the factory never announced the build. post-release-notes.mjs
    # polls for the exact build itself.
    skip_waiting_for_build_processing: true
  )
rescue StandardError => e
  raise unless only_spurious_resume_error?(e.message)

  UI.important(
    "altool failed the upload on '#{ALTOOL_SPURIOUS_RESUME_ERROR}' — checking whether build " \
    "#{build_number} reached App Store Connect anyway"
  )
  unless uploaded_build_listed?(build_number: build_number, app_version: app_version)
    lookup_note = @last_build_lookup_error ? " (last App Store Connect lookup error: #{@last_build_lookup_error})" : ""
    UI.user_error!(
      "Build #{build_number} (#{app_version}) never appeared in App Store Connect after altool's error: " \
      "#{e.message}#{lookup_note}"
    )
  end
  UI.success("Build #{build_number} is in App Store Connect, so altool's error was spurious — continuing")
end

# Polls App Store Connect for the macOS build the lane just uploaded: a fresh
# upload can take a few minutes to be listed. True once it is listed, processing
# or done; false if it never shows up. A failed lookup counts as "not listed yet"
# and its message is kept for the final error. A build in any other state (INVALID,
# FAILED) fails the lane: altool's error was real.
def uploaded_build_listed?(build_number:, app_version:)
  @last_build_lookup_error = nil
  UPLOADED_BUILD_POLL_ATTEMPTS.times do |attempt|
    build =
      begin
        find_asc_builds(
          app_identifier: BUNDLE_ID, asc_platform: "osx", build_number: build_number, app_version: app_version
        )&.first
      rescue StandardError => e
        @last_build_lookup_error = e.message
        UI.message("Build lookup failed (#{e.message})")
        nil
      end
    if build
      state = build.processing_state.to_s
      unless UPLOADED_BUILD_OK_STATES.include?(state)
        UI.user_error!("Build #{build_number} (#{app_version}) is #{state} in App Store Connect — the upload did not succeed")
      end
      return true
    end
    UI.message("Build #{build_number} not listed yet (attempt #{attempt + 1}/#{UPLOADED_BUILD_POLL_ATTEMPTS})")
    sleep(UPLOADED_BUILD_POLL_SECONDS) if attempt + 1 < UPLOADED_BUILD_POLL_ATTEMPTS
  end
  false
end

# Apply the App Store release settings `deliver` silently drops, and return the
# editable version it configured.
#
# In fastlane 2.232.2 `phased_release` and `automatic_release` are read in exactly
# ONE place: Deliver::UploadMetadata#upload derives `releaseType` from
# automatic_release (deliver/lib/deliver/upload_metadata.rb:181-196) and creates
# or deletes the phased release (:313-331). That method returns on its first line
# when skip_metadata is set (:88-89), and nothing else under deliver/lib touches
# either option. A promote lane MUST skip metadata — the repo keeps no `deliver`
# metadata directory, so uploading it would blank the App Store Connect version
# page — and therefore cannot get these applied by passing them to
# upload_to_app_store. It has to patch App Store Connect itself.
#
# This is not cosmetic. With releaseType left alone it keeps whatever the version
# already holds, and App Store Connect preselects "Automatically release this
# version" — so a submission the lane reported as manual would go public the
# moment Apple approved it, and `phased_release:false` would not turn phasing off.
#
# Runs BEFORE the submission, which is also deliver's own order (Runner#run:
# verify_version → upload_metadata → … → submit_for_review), so the version is
# still PREPARE_FOR_SUBMISSION when patched rather than in review. Every failure
# is a hard stop: nothing has been submitted yet, so a re-run costs nothing,
# whereas continuing would submit under settings the lane is about to claim it
# applied.
def apply_appstore_release_settings(asc_platform:, app_identifier:, app_version:, phased_release:, automatic_release:)
  platform = Spaceship::ConnectAPI::Platform.map(asc_platform)
  app = Spaceship::ConnectAPI::App.find(app_identifier)
  if app.nil?
    UI.user_error!(
      "#{app_identifier} not found in App Store Connect — cannot set the release settings for " \
      "#{app_version} (#{asc_platform})."
    )
  end

  # Idempotent, and the very call deliver's own verify_version makes moments later
  # with the same arguments: renames the editable version to app_version, or
  # creates it when the platform has none.
  app.ensure_version!(app_version, platform: platform)

  version = app.get_edit_app_store_version(platform: platform)
  if version.nil?
    UI.user_error!(
      "No editable #{asc_platform} App Store version for #{app_version}. Create it in App Store " \
      "Connect (App Store → #{asc_platform.to_s.casecmp('osx').zero? ? 'macOS' : 'iOS'} App) and re-run."
    )
  end

  # Read the phased-release state BEFORE anything is patched, and through a call
  # whose failure cannot be mistaken for "there is none".
  #
  # version.fetch_app_store_version_phased_release cannot be made fail-closed: a
  # version with no phased release answers with a body spaceship refuses to parse
  # (`raise "No data"`, spaceship/connect_api/model.rb:82), so ABSENCE ITSELF
  # arrives as an exception — and so do a 401, a 429 and a 5xx, by which point the
  # HTTP status and Apple's error code are gone (ConnectAPI::APIClient#format_errors
  # keeps only "title - detail", api_client.rb:340-355), leaving nothing to
  # discriminate on. deliver rescues the call regardless
  # (deliver/upload_metadata.rb:315-319); copying that rescue here would let a
  # transient failure look like absence, so `phased_release: false` would skip the
  # deletion while the lane went on to report phasing off — exactly the unverified
  # claim about App Store Connect this helper exists to prevent.
  #
  # Re-reading the version with the relationship INCLUDED is unambiguous instead:
  # Apple answers 200 with either a linked appStoreVersionPhasedRelease or an empty
  # relationship, and spaceship inflates the former into a model while leaving the
  # latter nil (connect_api/model.rb:133-166). `nil` therefore means App Store
  # Connect said there is none, and every failure — including an `include` Apple
  # rejects — stays an exception that stops the lane before anything is submitted
  # and before releaseType is touched.
  detailed = Spaceship::ConnectAPI::AppStoreVersion.get(
    app_store_version_id: version.id,
    includes: "appStoreVersionPhasedRelease"
  )
  if detailed.nil?
    UI.user_error!(
      "App Store version #{version.id} (#{app_version}, #{asc_platform}) could not be re-read from " \
      "App Store Connect — refusing to submit under release settings that cannot be verified."
    )
  end
  existing = detailed.app_store_version_phased_release

  release_type =
    if automatic_release
      Spaceship::ConnectAPI::AppStoreVersion::ReleaseType::AFTER_APPROVAL
    else
      Spaceship::ConnectAPI::AppStoreVersion::ReleaseType::MANUAL
    end
  version.update(attributes: { releaseType: release_type })
  UI.message("Release type set to #{release_type} on #{asc_platform} version #{version.version_string}")

  if phased_release
    if existing
      UI.message("Phased release already configured (#{existing.phased_release_state})")
    else
      version.create_app_store_version_phased_release(
        attributes: {
          phasedReleaseState: Spaceship::ConnectAPI::AppStoreVersionPhasedRelease::PhasedReleaseState::INACTIVE
        }
      )
      UI.message("Phased release created — INACTIVE until the version is released")
    end
  elsif existing
    existing.delete!
    UI.message("Phased release removed — every user gets the update at once")
  else
    # Stated rather than skipped silently: this branch is the one place the lane
    # reports phasing off without having changed anything, so the log has to show
    # that App Store Connect was actually read and had none.
    UI.message("No phased release on the #{asc_platform} version — every user gets the update at once")
  end

  version
end

# Uploads ./fastlane/screenshots/<locale>/*.png to the App Store version that is
# currently editable ("Prepare for Submission") on `platform`, replacing that
# locale's existing screenshots. deliver picks each PNG's display type from its
# pixel size. No app_version is passed, so deliver neither creates nor renames a
# version; nothing is built, no metadata is touched, nothing is submitted.
def upload_store_screenshots(platform:, app_identifier:)
  screenshots_path = File.join(PROJECT_ROOT, "fastlane", "screenshots")
  pngs = Dir.glob(File.join(screenshots_path, "*", "*.png"))
  UI.user_error!("No screenshots in #{screenshots_path} — run the store/screenshots generator first") if pngs.empty?

  api_key = app_store_connect_api_key(
    key_id: ENV["ASC_API_KEY_ID"],
    issuer_id: ENV["ASC_API_ISSUER_ID"],
    key_filepath: ENV["ASC_API_KEY_P8_PATH"],
    key_content: ENV["ASC_API_KEY_P8"],
    in_house: false
  )

  upload_to_app_store(
    api_key: api_key,
    app_identifier: app_identifier,
    platform: platform,
    screenshots_path: screenshots_path,
    overwrite_screenshots: true,
    skip_binary_upload: true,
    skip_metadata: true,
    skip_app_version_update: true,
    submit_for_review: false,
    run_precheck_before_submit: false,
    force: true
  )
  UI.success("Uploaded #{pngs.length} screenshots (#{platform})")
end

# ---------- macOS ----------

platform :mac do
  desc "Build and submit to TestFlight (macOS)"
  # Every caller of build_and_submit goes through restoring_lane_rewritten_files,
  # so a release leaves the checkout as clean as it found it.
  lane :beta do
    restoring_lane_rewritten_files { build_and_submit(destination: "testflight") }
  end

  desc "Rebuild from source and upload to the Mac App Store (hotfix path). Pass submit:true to also submit for review. Run `pnpm install` at the repo root first (the dependency preflight refuses a stale checkout); prefer `promote`, which submits the build testers already validated and does not build."
  lane :production do |options|
    restoring_lane_rewritten_files { build_and_submit(destination: "appstore", submit: options[:submit]) }
  end

  desc "Submit an ALREADY-UPLOADED macOS TestFlight build for Mac App Store review. Does NOT build — no CocoaPods, no Metro, no build_mac_app — so it needs no dependency preflight and is safe from any checkout with the Ruby gems installed. Options: build_number: (default: newest macOS build of the package.json version), submit: (true), phased_release: (true), automatic_release: (false)."
  lane :promote do |options|
    app_version = package_json_version
    submit = option_bool(options, :submit, true)
    phased_release = option_bool(options, :phased_release, true)
    automatic_release = option_bool(options, :automatic_release, false)

    api_key = app_store_connect_api_key(
      key_id: ENV["ASC_API_KEY_ID"],
      issuer_id: ENV["ASC_API_ISSUER_ID"],
      key_filepath: ENV["ASC_API_KEY_P8_PATH"],
      key_content: ENV["ASC_API_KEY_P8"],
      in_house: false
    )

    build_number = resolve_promote_build_number(
      api_key: api_key,
      asc_platform: "osx",
      app_identifier: BUNDLE_ID,
      app_version: app_version,
      requested: options[:build_number]
    )

    # deliver cannot apply phased_release:/automatic_release: under
    # skip_metadata: true (see apply_appstore_release_settings), so set them here,
    # before anything is submitted. Gated on submit: submit:false is a dry run and
    # must leave the version's release settings untouched.
    if submit
      apply_appstore_release_settings(
        asc_platform: "osx",
        app_identifier: BUNDLE_ID,
        app_version: app_version,
        phased_release: phased_release,
        automatic_release: automatic_release
      )
    end

    # automatic_release:/phased_release: are INERT on this call — deliver reads
    # them only in UploadMetadata#upload, which returns immediately under
    # skip_metadata: true. apply_appstore_release_settings above is what actually
    # applies them; they stay here because the spec asks for them and because a
    # future fastlane that honours them would set the same two values.
    upload_to_app_store(
      api_key: api_key,
      app_identifier: BUNDLE_ID,
      app_version: app_version,
      build_number: build_number,
      platform: "osx",
      skip_binary_upload: true,
      skip_metadata: true,
      skip_screenshots: true,
      submit_for_review: submit,
      automatic_release: automatic_release,
      phased_release: phased_release,
      force: true,
      precheck_include_in_app_purchases: false,
      submission_information: APPSTORE_SUBMISSION_INFORMATION
    )

    # No comment_released_issues / release tag here: submitting for review is not
    # a release. The build was already announced when it went to TestFlight, and
    # comment-released-issues.mjs posts "Now live in <track>", which would be a
    # lie until Apple approves and the operator presses Release This Version.
    #
    # submit:false is a dry run, NOT a "stage the build" mode. deliver consumes
    # build_number only in SubmitForReview#select_build — the single caller of
    # AppStoreVersion#select_build — and Runner#run skips that step entirely when
    # submit_for_review is false. With the binary, metadata and screenshots all
    # skipped, what remains is verify_version (which creates or renames the
    # editable App Store version) plus precheck: the build is resolved and
    # validated, but nothing is attached to the version.
    UI.success(
      "macOS #{app_version} (build #{build_number}) → Mac App Store: " \
      "#{submit ? 'submitted for review' : 'build resolved and validated only — NOT attached to the version, NOT submitted'}"
    )
    if submit
      UI.message("Phased release for automatic updates: #{phased_release ? 'on' : 'off'}")
      UI.message(
        automatic_release ? "Release: automatic once approved" : "Release: manual — press Release This Version after approval"
      )
    else
      UI.message(
        "phased_release:/automatic_release: were NOT applied — a dry run leaves the App Store " \
        "version's release settings exactly as they are."
      )
    end
  end

  desc "Upload fastlane/screenshots (from store/screenshots/generate-macos.sh) to the Mac App Store version"
  desc "being prepared, replacing its en-US screenshots. Builds and submits nothing; changes the store listing."
  lane :upload_screenshots do
    upload_store_screenshots(platform: "osx", app_identifier: BUNDLE_ID)
  end

  private_lane :build_and_submit do |options|
    destination = options[:destination]
    submit_for_review = option_bool(options, :submit, false)

    # Known Supabase project refs (public — they appear in URLs and shipped bundles; not secrets).
    known_prod_ref = "tbmjbxxseonkciqovnpl"
    known_dev_ref = "huhzactreblzcogqkbsd"

    # Bundle PROD Supabase credentials into this release.
    #
    # react-native-dotenv gives `process.env` the HIGHEST precedence over the `.env` file
    # (see undefObjectAssign in the plugin), so we inject `.env.production` into the
    # environment here — the same approach mobile uses (load_production_env) — rather than
    # copying it onto `.env`. The copy approach was silently overridden by the environment,
    # which is why 0.3.2 build 28 shipped DEV credentials. Injecting via the environment
    # also leaves `.env` (dev) untouched, so local debug builds keep using dev.
    #
    # Fail-fast: require `.env.production` and verify it points at the prod project (URL +
    # anon key). The bundle guard after build_mac_app then double-checks the compiled
    # output. Credential values are never logged.
    prod_env = File.join(PROJECT_ROOT, ".env.production")
    UI.user_error!("Missing apps/desktop/.env.production — cannot bundle prod credentials") unless File.exist?(prod_env)

    prod_env_contents = File.read(prod_env)
    prod_env_ref = prod_env_contents[%r{^SUPABASE_URL=https://([a-z0-9]+)\.supabase\.co}, 1]
    unless prod_env_ref == known_prod_ref
      UI.user_error!(".env.production must point at the prod Supabase project (#{known_prod_ref}); found #{prod_env_ref.inspect} — refusing to build")
    end
    if prod_env_contents[/^SUPABASE_ANON_KEY=(.+)$/, 1].to_s.strip.empty?
      UI.user_error!(".env.production is missing SUPABASE_ANON_KEY — refusing to build")
    end

    # Inject every key from .env.production into the environment so react-native-dotenv
    # inlines the prod values during bundling (process.env overrides the .env file).
    prod_env_contents.each_line do |line|
      line = line.strip
      next if line.empty? || line.start_with?("#")
      key, value = line.split("=", 2)
      ENV[key] = value if key && value
    end

    # Both run before CocoaPods: the preflight refuses a stale dependency graph,
    # and the Pods' Hermes / codegen phases need a NODE_BINARY that exists.
    assert_desktop_dependencies!
    ensure_xcode_env_local_node_binary

    # Install CocoaPods dependencies
    cocoapods(
      podfile: File.join(PROJECT_ROOT, "macos", "Podfile"),
      try_repo_update_on_error: true
    )

    # Runs after CocoaPods, whose post_install patches the codegen template it checks.
    assert_nil_safe_component_provider!

    # Configure App Store Connect API key
    api_key = app_store_connect_api_key(
      key_id: ENV["ASC_API_KEY_ID"],
      issuer_id: ENV["ASC_API_ISSUER_ID"],
      key_filepath: ENV["ASC_API_KEY_P8_PATH"],
      key_content: ENV["ASC_API_KEY_P8"],
      in_house: false
    )

    # Remove stale "Apple Distribution" certs to avoid ambiguity during archive.
    # Match may have previously installed a mac_installer_distribution cert with the same
    # "Apple Distribution" name, causing Xcode to fail with "profile doesn't include cert".
    keychain = File.expand_path("~/Library/Keychains/login.keychain-db")
    hashes = `security find-certificate -a -c "Apple Distribution" -Z "#{keychain}" 2>/dev/null`
      .scan(/SHA-1 hash: (\w+)/).flatten
    hashes.each { |h| system("security", "delete-certificate", "-Z", h, keychain) }

    # Fetch macOS app distribution cert + profile from match
    match(
      type: "appstore",
      platform: "macos",
      app_identifier: BUNDLE_ID,
      api_key: api_key,
      readonly: true
    )

    # Sync version from package.json to Xcode MARKETING_VERSION
    version = package_json_version
    increment_version_number(
      version_number: version,
      xcodeproj: File.join(PROJECT_ROOT, "macos", "Drafto.xcodeproj")
    )

    # Auto-increment build number from TestFlight
    latest_build = begin
      latest_testflight_build_number(
        api_key: api_key,
        app_identifier: BUNDLE_ID,
        platform: "osx"
      )
    rescue StandardError => e
      UI.important("Could not fetch latest build number (#{e.message}), defaulting to 0")
      0
    end

    new_build_number = latest_build + 1
    increment_build_number(
      build_number: new_build_number,
      xcodeproj: File.join(PROJECT_ROOT, "macos", "Drafto.xcodeproj")
    )

    # Update code signing for the macOS target
    update_code_signing_settings(
      path: File.join(PROJECT_ROOT, "macos", "Drafto.xcodeproj"),
      use_automatic_signing: false,
      team_id: "4J2USPSG2U",
      profile_name: "match AppStore eu.drafto.mobile macos",
      code_sign_identity: "Apple Distribution",
      targets: ["Drafto-macOS"]
    )

    # Strip NSAllowsArbitraryLoads for App Store submission
    update_info_plist(
      xcodeproj: File.join(PROJECT_ROOT, "macos", "Drafto.xcodeproj"),
      plist_path: "Drafto-macOS/Info.plist",
      block: proc do |plist|
        ats = plist["NSAppTransportSecurity"]
        if ats
          ats.delete("NSAllowsArbitraryLoads")
          ats.delete("NSExceptionDomains")
          plist.delete("NSAppTransportSecurity") if ats.empty?
        end
      end
    )

    # Build and export .app (skip .pkg — we create it separately with the installer cert).
    build_mac_app(
      workspace: File.join(PROJECT_ROOT, "macos", "Drafto.xcworkspace"),
      scheme: "Drafto-macOS",
      export_method: "app-store",
      output_directory: File.join(PROJECT_ROOT, "macos", "build"),
      skip_package_pkg: true,
      export_options: {
        signingStyle: "manual",
        provisioningProfiles: {
          BUNDLE_ID => "match AppStore eu.drafto.mobile macos"
        }
      }
    )

    # Keystone guard: verify the COMPILED bundle points at the prod Supabase project and
    # contains no dev reference, before anything is uploaded. Makes it structurally
    # impossible to ship a dev-pointed build again (the cause of 0.3.2 build 28). Matches
    # only the public project ref/URL — never the anon key.
    js_bundle = File.join(PROJECT_ROOT, "macos", "build", "Drafto.app", "Contents", "Resources", "main.jsbundle")
    UI.user_error!("Built bundle not found at #{js_bundle}") unless File.exist?(js_bundle)
    bundle_strings = `strings -a "#{js_bundle}"`
    unless bundle_strings.include?(known_prod_ref)
      UI.user_error!("Release bundle does not reference the prod Supabase project (#{known_prod_ref}) — aborting upload")
    end
    if bundle_strings.include?(known_dev_ref)
      UI.user_error!("Release bundle references the DEV Supabase project (#{known_dev_ref}) — aborting upload")
    end
    UI.success("Verified release bundle points at prod Supabase project #{known_prod_ref}")

    # Create .pkg with the "3rd Party Mac Developer Installer" cert (created via Xcode)
    app_path = File.join(PROJECT_ROOT, "macos", "build", "Drafto.app")
    pkg_path = File.join(PROJECT_ROOT, "macos", "build", "Drafto.pkg")
    sh("productbuild",
       "--component", app_path, "/Applications",
       "--sign", "3rd Party Mac Developer Installer: Jakub Anderwald (4J2USPSG2U)",
       pkg_path)

    # Upload
    if destination == "testflight"
      upload_to_testflight_checked(
        api_key: api_key, pkg: pkg_path, build_number: new_build_number, app_version: version
      )
    else
      # app_version / platform are explicit because ASC app 6760675784 serves BOTH
      # macOS and iOS — left to deliver's own guess, a submission can land on the
      # wrong platform's version. submission_information only reaches App Store
      # Connect on the submit:true path — deliver sends it from SubmitForReview —
      # so an upload-only run leaves the IDFA / export-compliance questions to be
      # answered when someone submits from App Store Connect.
      upload_to_app_store(
        api_key: api_key,
        app_identifier: BUNDLE_ID,
        app_version: version,
        platform: "osx",
        pkg: pkg_path,
        skip_metadata: true,
        skip_screenshots: true,
        submit_for_review: submit_for_review,
        force: submit_for_review,
        precheck_include_in_app_purchases: false,
        submission_information: APPSTORE_SUBMISSION_INFORMATION
      )
    end

    # Post release notes
    post_release_notes(max_chars: 4000, build: new_build_number)

    # Phase G: comment "Now live" on closed support issues for this build — for
    # TestFlight ONLY. comment-released-issues.mjs posts "Now live in <track>",
    # and a Mac App Store upload is not a release: the build still has to pass App
    # Review and then be released by hand. Telling a customer their fix is live on
    # the Mac App Store the moment a binary is uploaded is simply false.
    if destination == "appstore"
      UI.message(
        "Mac App Store upload — no customer 'now live' notice: the build is not public until Apple " \
        "approves it and Release This Version is pressed."
      )
    else
      track_label = "TestFlight macOS (build #{new_build_number})"
      comment_released_issues(build: new_build_number, track: track_label)
      comment_intest_build(build: new_build_number, track: track_label)
    end

    # Tag this release (e.g. desktop@0.3.2+45) so generate-release-notes.sh scopes
    # the NEXT build's "What to Test" to the delta since this build, instead of
    # dumping the whole history. There were no desktop@ tags at all because
    # desktop ships from a local checkout, not from the desktop-*-release.yml CI
    # (see docs/operations/builds-and-releases.md), so its tag job never runs —
    # tag here instead. `-v:refname` orders the +build suffix
    # numerically (verified). Non-fatal: a tag/push failure must not fail an
    # already-shipped release.
    #
    # NEVER tag a pre-merge test build. Those lanes build the PR head, which is
    # unmerged and may be rebased away entirely — tagging it publishes a release
    # tag pointing at a commit that is on no branch, and the tag is then the only
    # thing keeping that commit alive. It also poisons this very mechanism: the
    # next real release starts its range at the newest tag, which would sit on an
    # abandoned branch.
    #
    # Both happened. `desktop@0.3.2+49` → b243d819 and `desktop@0.3.2+50` →
    # 0d1fa723 were pushed to origin for issue #463's pre-merge builds, and
    # b243d819 was orphaned when the branch was rebased.
    if ENV["DRAFTO_INTEST_ISSUE"].to_s.empty?
      begin
        release_tag = "desktop@#{version}+#{new_build_number}"
        if `git tag -l "#{release_tag}"`.strip.empty?
          sh("git", "tag", release_tag)
          sh("git", "push", "origin", release_tag)
          UI.success("Tagged release #{release_tag}")
        else
          UI.message("Release tag #{release_tag} already exists — skipping")
        end
      rescue StandardError => e
        UI.important("Release tagging failed (non-fatal): #{e.message}")
      end
    else
      UI.message("Pre-merge test build (issue ##{ENV['DRAFTO_INTEST_ISSUE']}) — not tagging an unmerged commit")
    end
  end
end
