{
  "permissions": {
    "allow": ["Bash(bundle exec fastlane mac *)"]
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume",
        "hooks": [
          {
            "type": "command",
            "command": "H=\"$CLAUDE_PROJECT_DIR/.claude/hooks\"; [ -f \"$H/sync-cloud-skills.sh\" ] || H=\"$(git rev-parse --show-toplevel 2>/dev/null)/.claude/hooks\"; bash \"$H/sync-cloud-skills.sh\"",
            "timeout": 60
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "H=\"$CLAUDE_PROJECT_DIR/.claude/hooks\"; [ -f \"$H/prevent-main-commit.sh\" ] || H=\"$(git rev-parse --show-toplevel 2>/dev/null)/.claude/hooks\"; bash \"$H/prevent-main-commit.sh\""
          },
          {
            "type": "command",
            "command": "H=\"$CLAUDE_PROJECT_DIR/.claude/hooks\"; [ -f \"$H/prevent-main-push.sh\" ] || H=\"$(git rev-parse --show-toplevel 2>/dev/null)/.claude/hooks\"; bash \"$H/prevent-main-push.sh\""
          },
          {
            "type": "command",
            "command": "H=\"$CLAUDE_PROJECT_DIR/.claude/hooks\"; [ -f \"$H/migration-stats-pre.sh\" ] || H=\"$(git rev-parse --show-toplevel 2>/dev/null)/.claude/hooks\"; bash \"$H/migration-stats-pre.sh\""
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "H=\"$CLAUDE_PROJECT_DIR/.claude/hooks\"; [ -f \"$H/migration-stats-post.sh\" ] || H=\"$(git rev-parse --show-toplevel 2>/dev/null)/.claude/hooks\"; bash \"$H/migration-stats-post.sh\""
          }
        ]
      }
    ]
  }
}
